	depends = python-crcmod
	depends = python-cryptography
	depends = python-dbus-fast
	depends = python-pyasn1
	optdepends = power-profiles-daemon: power saving mode during an outage
	optdepends = libnotify: desktop notifications
	optdepends = ddcutil: lower monitor brightness during an outage
	optdepends = bluez-utils: lets bleak detect the BlueZ version (otherwise it logs a warning)
	optdepends = plasma-workspace: KDE Plasma widget
